---
title: "Cognitive Partners — The Future Thinks Together"
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Cognitive Partners — The Future Thinks Together</title>
  <meta name="description" content="Automated AI Solutions That Intelligently Evolve With Your Needs." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@300;400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cp-purple: #534AB7;
      --cp-violet: #7B6FD4;
      --cp-blue: #4A8FE7;
      --cp-cyan: #00D4FF;
      --cp-darker: #050508;
    }

    html { scroll-behavior: smooth; }

    body {
      background-color: var(--cp-darker);
      color: #E8E8F0;
      font-family: Manrope, sans-serif;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── BACKGROUND ── */
    .bg-canvas {
      position: fixed;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }

    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      animation: drift 20s ease-in-out infinite;
    }

    .orb-1 {
      width: 600px; height: 600px;
      background: radial-gradient(circle, rgba(83,74,183,0.25) 0%, transparent 70%);
      top: -100px; left: -150px;
      animation-delay: 0s;
    }

    .orb-2 {
      width: 500px; height: 500px;
      background: radial-gradient(circle, rgba(0,212,255,0.15) 0%, transparent 70%);
      bottom: -50px; right: -100px;
      animation-delay: -7s;
    }

    .orb-3 {
      width: 400px; height: 400px;
      background: radial-gradient(circle, rgba(74,143,231,0.12) 0%, transparent 70%);
      top: 40%; left: 50%;
      transform: translate(-50%, -50%);
      animation-delay: -14s;
    }

    .bg-canvas::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      opacity: 0.35;
      pointer-events: none;
    }

    .bg-grid {
      position: fixed;
      inset: 0;
      z-index: 0;
      background-image:
        linear-gradient(rgba(83,74,183,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(83,74,183,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
    }

    /* ── LAYOUT ── */
    .wrapper {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── HERO ── */
    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0 2rem 4rem;
      text-align: center;
    }

    /* ── LOGO ── */
    .logo-img {
      width: 160px;
      height: auto;
      display: block;
      margin-top: 60px;
      margin-bottom: 16px;
      opacity: 0;
      animation: fadeIn 1s ease 0.2s forwards;
      mix-blend-mode: screen;
    }

    /* ── EYEBROW ── */
    .eyebrow {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.32em;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--cp-cyan);
      opacity: 0;
      animation: fadeUp 0.8s ease 0.4s forwards;
      margin-bottom: 28px;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .eyebrow::before, .eyebrow::after {
      content: '';
      display: block;
      width: 40px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--cp-cyan));
    }
    .eyebrow::after {
      background: linear-gradient(90deg, var(--cp-cyan), transparent);
    }

    /* ── HEADLINE ── */
    h1 {
      font-family: Manrope, sans-serif;
      font-weight: 800;
      font-size: 76px;
      line-height: 1.08;
      letter-spacing: -0.045em;
      max-width: 1100px;
      text-align: center;
      margin-bottom: 28px;
      color: #fff;
      opacity: 0;
      animation: fadeUp 0.8s ease 0.6s forwards;
    }

    h1 .gradient-text {
      background: linear-gradient(135deg, var(--cp-violet) 0%, var(--cp-cyan) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ── SUBCOPY ── */
    .tagline {
      font-family: Manrope, sans-serif;
      font-size: 17px;
      font-weight: 400;
      line-height: 1.65;
      color: rgba(232,232,240,0.65);
      max-width: 560px;
      margin-bottom: 36px;
      opacity: 0;
      animation: fadeUp 0.8s ease 0.8s forwards;
    }

    /* ── COMING SOON PILL ── */
    .coming-soon {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(83,74,183,0.12);
      border: 1px solid rgba(83,74,183,0.3);
      border-radius: 100px;
      padding: 0.5rem 1.25rem;
      font-family: Manrope, sans-serif;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(123,111,212,0.9);
      opacity: 0;
      animation: fadeUp 0.8s ease 0.9s forwards;
      margin-bottom: 28px;
    }

    .coming-soon-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--cp-cyan);
      animation: glowPulse 2s ease-in-out infinite;
    }

    /* ── CTA ── */
    .cta-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      opacity: 0;
      animation: fadeUp 0.8s ease 1s forwards;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      width: 240px;
      height: 54px;
      background: linear-gradient(135deg, var(--cp-purple), var(--cp-blue));
      color: #fff;
      font-family: Manrope, sans-serif;
      font-weight: 700;
      font-size: 15px;
      letter-spacing: 0.02em;
      border-radius: 8px;
      text-decoration: none;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      box-shadow: 0 0 30px rgba(83,74,183,0.3), 0 4px 20px rgba(0,0,0,0.4);
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, var(--cp-violet), var(--cp-cyan));
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .btn-primary:hover::before { opacity: 1; }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 50px rgba(83,74,183,0.5), 0 8px 30px rgba(0,0,0,0.5);
    }

    .btn-primary span { position: relative; z-index: 1; }

    .btn-arrow {
      position: relative;
      z-index: 1;
      transition: transform 0.3s ease;
    }
    .btn-primary:hover .btn-arrow { transform: translateX(4px); }

    .contact-link {
      font-family: Manrope, sans-serif;
      font-size: 11px;
      font-weight: 500;
      color: rgba(232,232,240,0.4);
      text-decoration: none;
      letter-spacing: 0.08em;
      margin-top: 20px;
      transition: color 0.3s ease;
    }
    .contact-link:hover { color: var(--cp-cyan); }

    /* ── LEAD CAPTURE FORM ── */
    .form-section {
      width: 100%;
      max-width: 480px;
      margin-top: 56px;
      opacity: 0;
      animation: fadeUp 0.8s ease 1.1s forwards;
    }

    .form-divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 24px;
    }

    .form-divider::before,
    .form-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: rgba(83,74,183,0.2);
    }

    .form-divider-text {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(232,232,240,0.3);
      white-space: nowrap;
    }

    .lead-form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .form-input {
      width: 100%;
      height: 48px;
      background: rgba(83,74,183,0.06);
      border: 1px solid rgba(83,74,183,0.2);
      border-radius: 8px;
      padding: 0 16px;
      font-family: Manrope, sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: #E8E8F0;
      outline: none;
      transition: all 0.2s ease;
    }

    .form-input::placeholder {
      color: rgba(232,232,240,0.3);
    }

    .form-input:focus {
      border-color: rgba(83,74,183,0.6);
      background: rgba(83,74,183,0.1);
      box-shadow: 0 0 0 3px rgba(83,74,183,0.1);
    }

    .btn-submit {
      width: 100%;
      height: 52px;
      background: linear-gradient(135deg, var(--cp-purple), var(--cp-blue));
      color: #fff;
      font-family: Manrope, sans-serif;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.04em;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      box-shadow: 0 0 30px rgba(83,74,183,0.3), 0 4px 20px rgba(0,0,0,0.4);
      margin-top: 4px;
    }

    .btn-submit::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, var(--cp-violet), var(--cp-cyan));
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .btn-submit:hover::before { opacity: 1; }
    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 50px rgba(83,74,183,0.5), 0 8px 30px rgba(0,0,0,0.5);
    }

    .btn-submit:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .btn-submit-text { position: relative; z-index: 1; }

    .form-privacy {
      font-family: Manrope, sans-serif;
      font-size: 10px;
      font-weight: 500;
      color: rgba(232,232,240,0.25);
      text-align: center;
      letter-spacing: 0.04em;
      margin-top: 4px;
    }

    /* ── FORM SUCCESS STATE ── */
    .form-success {
      display: none;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 32px;
      background: rgba(0,212,255,0.05);
      border: 1px solid rgba(0,212,255,0.2);
      border-radius: 12px;
      text-align: center;
    }

    .form-success.visible { display: flex; }

    .success-icon {
      width: 48px; height: 48px;
      border-radius: 50%;
      background: rgba(0,212,255,0.1);
      border: 1px solid rgba(0,212,255,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--cp-cyan);
    }

    .success-title {
      font-family: Manrope, sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: #fff;
    }

    .success-body {
      font-family: Manrope, sans-serif;
      font-size: 13px;
      font-weight: 400;
      color: rgba(232,232,240,0.55);
      line-height: 1.6;
    }

    /* ── FORM ERROR ── */
    .form-error {
      display: none;
      font-family: Manrope, sans-serif;
      font-size: 12px;
      color: rgba(255,100,100,0.8);
      text-align: center;
      margin-top: 8px;
    }
    .form-error.visible { display: block; }

    /* ── FOOTER ── */
    footer {
      position: relative;
      z-index: 1;
      padding: 1.5rem 3rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid rgba(83,74,183,0.1);
      opacity: 0;
      animation: fadeIn 1s ease 1.2s forwards;
    }

    .footer-left {
      font-family: Manrope, sans-serif;
      font-size: 11px;
      font-weight: 500;
      color: rgba(232,232,240,0.25);
      letter-spacing: 0.08em;
    }

    .footer-right a {
      font-family: Manrope, sans-serif;
      font-size: 11px;
      font-weight: 500;
      color: rgba(0,212,255,0.4);
      text-decoration: none;
      letter-spacing: 0.06em;
      transition: color 0.3s ease;
    }
    .footer-right a:hover { color: var(--cp-cyan); }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes glowPulse {
      0%, 100% { opacity: 0.5; box-shadow: 0 0 4px var(--cp-cyan); }
      50% { opacity: 1; box-shadow: 0 0 10px var(--cp-cyan); }
    }

    @keyframes drift {
      0%, 100% { transform: translate(0, 0) rotate(0deg); }
      25% { transform: translate(20px, -20px) rotate(2deg); }
      50% { transform: translate(-10px, 15px) rotate(-1deg); }
      75% { transform: translate(15px, 10px) rotate(1deg); }
    }

    /* ── MOBILE ── */
    @media (max-width: 640px) {
      .logo-img { width: 110px; margin-bottom: 36px; }
      h1 { font-size: 44px; letter-spacing: -0.03em; }
      .form-row { grid-template-columns: 1fr; }
      footer { padding: 1.5rem; flex-direction: column; gap: 0.5rem; text-align: center; }
    }
  </style>
</head>
<body>
  <div class="bg-canvas">
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
  </div>
  <div class="bg-grid"></div>

  <div class="wrapper">
    <main>
      <img
        src="/Cognitive_Partners_logo-1.png"
        alt="Cognitive Partners"
        class="logo-img"
      />

      <div class="eyebrow">The Future Thinks Together</div>

      <h1>
        <span class="gradient-text">Intelligent AI</span><br />
        That Evolves With You
      </h1>

      <p class="tagline">
        Automated AI solutions that intelligently evolve with your needs — built for the businesses ready to think differently.
      </p>

      <div class="coming-soon">
        <div class="coming-soon-dot"></div>
        Full Site Coming Soon
      </div>

      <div class="cta-group">
        <a href="https://book.cognitivepartners.ai" class="btn-primary" target="_blank" rel="noopener">
          <span>Book a Discovery Call</span>
          <svg class="btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="mailto:hello@cognitivepartners.ai" class="contact-link">hello@cognitivepartners.ai</a>
      </div>

      <!-- ── LEAD CAPTURE FORM ── -->
      <div class="form-section">
        <div class="form-divider">
          <span class="form-divider-text">Or get the inside track first</span>
        </div>

        <div id="lead-form-wrap">
          <div class="lead-form" id="lead-form">
            <div class="form-row">
              <input
                type="text"
                id="firstName"
                class="form-input"
                placeholder="First name"
                autocomplete="given-name"
                required
              />
              <input
                type="text"
                id="lastName"
                class="form-input"
                placeholder="Last name"
                autocomplete="family-name"
                required
              />
            </div>
            <input
              type="email"
              id="email"
              class="form-input"
              placeholder="Work email"
              autocomplete="email"
              required
            />
            <button class="btn-submit" id="submit-btn" type="button">
              <span class="btn-submit-text">Send Me the Inside Track</span>
            </button>
            <p class="form-privacy">No spam. No pressure. Unsubscribe anytime.</p>
            <p class="form-error" id="form-error">Something went wrong — please try again.</p>
          </div>
        </div>

        <div class="form-success" id="form-success">
          <div class="success-icon">
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
              <path d="M4 11l5 5L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="success-title">You're in.</div>
          <div class="success-body">Check your inbox — we'll be in touch shortly.<br/>In the meantime, feel free to book a discovery call.</div>
        </div>
      </div>

    </main>

    <footer>
      <div class="footer-left">© 2026 Cognitive Partners</div>
    </footer>
  </div>

  <script>
    const WEBHOOK_URL = 'https://cognitivepartners.app.n8n.cloud/webhook/cp-lead-capture';

    const submitBtn = document.getElementById('submit-btn');
    const formError = document.getElementById('form-error');
    const formSuccess = document.getElementById('form-success');
    const leadForm = document.getElementById('lead-form');

    submitBtn.addEventListener('click', async () => {
      const firstName = document.getElementById('firstName').value.trim();
      const lastName = document.getElementById('lastName').value.trim();
      const email = document.getElementById('email').value.trim();

      // Basic validation
      if (!firstName || !lastName || !email) {
        formError.textContent = 'Please fill in all fields.';
        formError.classList.add('visible');
        return;
      }

      if (!email.includes('@')) {
        formError.textContent = 'Please enter a valid email address.';
        formError.classList.add('visible');
        return;
      }

      formError.classList.remove('visible');
      submitBtn.disabled = true;
      submitBtn.querySelector('.btn-submit-text').textContent = 'Sending...';

      try {
        const response = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            firstName,
            lastName,
            email,
            source: 'source-homepage'
          })
        });

        if (response.ok) {
          leadForm.style.display = 'none';
          formSuccess.classList.add('visible');
        } else {
          throw new Error('Non-OK response');
        }
      } catch (err) {
        submitBtn.disabled = false;
        submitBtn.querySelector('.btn-submit-text').textContent = 'Send Me the Inside Track';
        formError.textContent = 'Something went wrong — please try again.';
        formError.classList.add('visible');
      }
    });
  </script>
</body>
</html>
